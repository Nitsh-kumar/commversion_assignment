# LLM Configuration
# Supported providers: groq, openai, gemini, nvidia, openrouter, ollama, openai_compatible
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_llm_api_key_here
# Optional: required only for nvidia, openrouter, ollama, or custom OpenAI-compatible endpoints
LLM_BASE_URL=

# Embedding Configuration (used for FAQ RAG over data/faq.csv)
# Supported providers: local, openai, gemini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Optional: leave blank when using local sentence-transformers embeddings
EMBEDDING_API_KEY=

# Optional Observability / Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ashcombe-rowe-chatbot
